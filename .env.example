# Copia este archivo como .env (no se sube a GitHub) y rellena los valores.

# Puerto HTTP (Render lo define automáticamente)
PORT=3000

# Base de datos PostgreSQL. Si se deja vacío se usa PGlite (PostgreSQL embebido) en DATA_DIR.
DATABASE_URL=

# Carpeta de datos para PGlite cuando no hay DATABASE_URL
DATA_DIR=./data/pglite

# Código de invitación para obtener el rol de administrador (solo lo conoce el servidor)
ADMIN_INVITE_CODE=pon-aqui-tu-codigo-secreto
